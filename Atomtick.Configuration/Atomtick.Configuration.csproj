<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net462;net8.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <PackageReadmeFile></PackageReadmeFile>
        <Title>$(AssemblyName)</Title>
        <PackageTags>config;xml</PackageTags>
        <IncludeSymbols>True</IncludeSymbols>
        <PackageIcon>setting.png</PackageIcon>
        <SignAssembly>True</SignAssembly>
        <DelaySign>False</DelaySign>
        <RepositoryUrl>https://github.com/atomtick/ZeroGC.SCADA.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/atomtick/ZeroGC.SCADA.git</PackageProjectUrl>
        <Copyright>Copyright © 2026 atomtick</Copyright>
        <Version>2026.8.29</Version>
        <RepositoryType>git</RepositoryType>
        <Authors>atomtick</Authors>
        <Description>A class library for high-performance read and write configuration based on XML.</Description>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="setting.png" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Assets\setting.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
        <PackageReference Include="System.Threading.Channels" Version="9.0.9" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="System.Threading.Channels" Version="9.0.9" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
        <PackageReference Include="System.ValueTuple" Version="4.6.2" />
        <PackageReference Include="ZLinq" Version="1.5.6" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Assets\ExceptionMessages.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>ExceptionMessages.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Assets\ExceptionMessages.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>ExceptionMessages.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>


	<ItemGroup>
		<!-- 将 settings.json 文件打包到 NuGet 中 -->
		<Content Include="Assets/configs.db">
			<!-- 1. 允许打包此文件 -->
			<Pack>true</Pack>

			<!-- 2. 指定在 NuGet 包内部的路径。
           contentFiles\any\any 表示不限制目标框架和语言。
           content 是为了向后兼容旧的 packages.config 模式。-->
			<PackagePath>contentFiles\any\any;content</PackagePath>

			<!-- 3. (可选) 安装此包的项目在编译时，是否将该文件复制到输出目录 (bin/Debug) -->
			<PackageCopyToOutput>true</PackageCopyToOutput>

			<!-- 4. (可选) 控制安装此包的项目如何处理该文件 (例如设为 None 或 Content) -->
			<BuildAction>Content</BuildAction>
		</Content>
	</ItemGroup>
	
	
    <!--指定程序集的internal成员可在另一个程序集中被调用-->
    <ItemGroup>
        <InternalsVisibleTo Include="SCADA.Configuration.UnitTests" />
    </ItemGroup>
    <ItemGroup>
      <None Include="Assets\configs.db" Link="Assets\configs.db" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Atomtick.Common\Atomtick.Common.csproj" />
    </ItemGroup>
</Project>
