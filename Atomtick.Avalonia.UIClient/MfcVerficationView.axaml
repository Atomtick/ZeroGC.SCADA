<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Atomtick.Avalonia.UIClient.MfcVerficationView">
    <Grid RowDefinitions="Auto *">
        <GroupBox Header="Verfication Mode">
            <StackPanel Orientation="Horizontal">
                <Button Content="Single Point"></Button>
                <Button Content="Ten Points"></Button>
                <Button Content="Daily Check"></Button>
                <Button Content="Custom"></Button>
            </StackPanel>
        </GroupBox>

        <DataGrid>
            <DataGrid.Columns>
                <DataGridTextColumn Header="GasName">
                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="Setpoint(Sccm)">
                    
                </DataGridTextColumn>
                <DataGridComboBoxColumn Header="Setpoint(Ratio)">
                    
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="Error Rate(S.P.)">
                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="Error Rate(F.S.)">
                    
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
